# Copy this file to `.env` and fill in values from Supabase → Project Settings → API

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Claude AI key is used later in a Supabase Edge Function (not in the mobile app)
# ANTHROPIC_API_KEY=sk-ant-...
